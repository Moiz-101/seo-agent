# Telegram (BotFather se milega, free)
TELEGRAM_BOT_TOKEN=
# Sirf yeh chat/user id hi bot ko commands de sakega (apna Telegram user id daalo)
TELEGRAM_ALLOWED_USER_ID=

# Google Gemini (aistudio.google.com se free API key)
GEMINI_API_KEY=

# Google PageSpeed Insights (free, Google Cloud Console se enable karo)
PAGESPEED_API_KEY=

# Google Search Console (service-account JSON file ka path)
GSC_SERVICE_ACCOUNT_FILE=credentials/gsc_service_account.json
GSC_SITE_URL=https://example.com/

# Open PageRank (free, openpagerank.com) - authority score proxy
OPEN_PAGERANK_API_KEY=

# Set on Render (or any cloud host) to run in webhook mode instead of polling.
# e.g. https://your-app.onrender.com  (no trailing slash, no leading value locally)
WEBHOOK_URL=
PORT=8080

# Upstash Redis (free forever) - durable state across restarts
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
